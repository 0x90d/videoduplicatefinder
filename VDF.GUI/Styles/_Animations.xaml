<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Everything in this file moves, so everything in it applies only while the window does
         not carry the reduce-motion class, which Appearance sets for users who asked their
         system (or VDF) for less motion. -->

    <!-- Metric hover diff: smooth color transition (matches web's transition: color 0.15s) -->
    <Style Selector="Window:not(.reduce-motion) TextBlock.metric-diff">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Skeleton shimmer loading animation for thumbnails. It runs for as long as
         thumbnails load, on every placeholder on screen at once, so it stands still for
         users who asked their system for less motion: the window carries the
         reduce-motion class then (MotionPreference). -->
    <Style Selector="Border.skeleton-shimmer">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="Window.reduce-motion Border.skeleton-shimmer">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Window:not(.reduce-motion) Border.skeleton-shimmer">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="CubicEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0.3" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.7" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
