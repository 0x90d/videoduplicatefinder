<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VDF.GUI" />
    <InternalsVisibleTo Include="vdf-cli" />
    <InternalsVisibleTo Include="VDF.Web" />
    <InternalsVisibleTo Include="VDF.Core.Tests" />
    <InternalsVisibleTo Include="VDF.CLI.Tests" />
    <InternalsVisibleTo Include="VDF.Web.Tests" />
    <InternalsVisibleTo Include="VDF.IntegrationTests" />
    <InternalsVisibleTo Include="VDF.Benchmarks" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="MemoryPack" Version="1.22.0" />
    <!-- The full package: the managed wrapper (pure P/Invoke, Native-AOT-safe) plus the native
         onnxruntime library for each platform, which publish copies next to the app. Microsoft
         no longer serves the runtime from GitHub, and nuget.org packages are immutable.
         Version must equal AiComponents.RuntimeVersion. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
    <PackageReference Include="System.Numerics.Tensors" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\Locales\en.json" />
    <EmbeddedResource Include="Assets\Locales\de.json" />
    <EmbeddedResource Include="Assets\Locales\es.json" />
    <EmbeddedResource Include="Assets\Locales\fr.json" />
    <EmbeddedResource Include="Assets\Locales\ko.json" />
    <EmbeddedResource Include="Assets\Locales\pt.json" />
    <EmbeddedResource Include="Assets\Locales\ru.json" />
    <EmbeddedResource Include="Assets\Locales\zh-Hans.json" />
  </ItemGroup>

</Project>
