@rendermode InteractiveServer
@inject IJSRuntime JS

<button class="theme-toggle" @onclick="Toggle" title="Toggle dark/light mode">
    @(_theme == "dark" ? "\u2600" : "\u263D")
</button>

@code {
    string _theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            try {
                _theme = await JS.InvokeAsync<string>("vdf.getTheme");
                StateHasChanged();
            }
            // Browser gone or script failed: keep the dark default the page starts in.
            catch (Exception e) when (e is JSDisconnectedException or TaskCanceledException or JSException) { }
        }
    }

    async Task Toggle() {
        _theme = _theme == "dark" ? "light" : "dark";
        await JS.TryInvokeVoidAsync("vdf.setTheme", _theme);
    }
}
